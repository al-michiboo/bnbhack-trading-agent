# =============================================
#  Mavis — BNB Hack Trading Agent  .env example
# =============================================
# Copy to .env and fill in your real keys.
# NEVER commit .env. It's in .gitignore.

# --- Mode ---
# paper = simulate trades, no real tx
# live  = real on-chain tx on testnet (or mainnet if BNB_NETWORK=mainnet)
Mavis_MODE=paper

# --- CoinMarketCap AI Agent Hub ---
# Get a key at: https://pro.coinmarketcap.com/signup
# The "AI Agent Hub" endpoints include:
#   /v1/cryptocurrency/quotes/latest
#   /v1/cryptocurrency/ohlcv/historical
#   /v3/agent/hub/market-intelligence   (agent-native)
#   /v3/agent/hub/sentiment             (agent-native)
#   /v3/agent/hub/narratives            (agent-native)
CMC_API_KEY=your_cmc_api_key_here
CMC_BASE_URL=https://pro-api.coinmarketcap.com

# --- LLM provider (for signal generation) ---
# OpenAI used as default; Anthropic supported too.
OPENAI_API_KEY=sk-your_openai_key_here
# Optional: override model
Mavis_LLM_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...

# --- X / Twitter (for narrative/track 2) ---
# Get credentials at: https://developer.twitter.com/en/portal
X_BEARER_TOKEN=your_x_bearer_token_here
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Watchlist of KOLs to monitor (comma-separated handles, no @)
Mavis_X_WATCHLIST=cz_binance,vitalikbuterin,Lookonchain,DefiIgnas,0xMert_

# --- BNB Chain ---
# BNB Smart Chain testnet: chain id 97
# Mainnet: chain id 56
BNB_NETWORK=testnet
BNB_CHAIN_ID=97
BNB_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
# Your testnet wallet private key (NEVER use a mainnet key here)
TW_PRIVATE_KEY=

# Trust Wallet Agent Kit config
# https://github.com/trustwallet/agent-kit
TW_AGENT_KIT_RPC=https://api-agent-kit.trustwallet.com
TW_AGENT_KIT_API_KEY=

# --- Risk limits ---
MAX_POSITION_USD=100
MAX_DRAWDOWN_PCT=10
DAILY_TRADE_CAP=20
STOP_LOSS_PCT=5
TAKE_PROFIT_PCT=12

# --- Dashboard / API ---
DASHBOARD_PORT=8080
LOG_LEVEL=INFO
